{
  "name": "oj-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "cd ../frontend && npm run build:site && cd ../backend && node -e \"require('fs').copyFileSync('.env','wrangler.prod.toml')\" && wrangler deploy --config wrangler.prod.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bcryptjs": "^2.4.3",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^9.28.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.2",
    "eslint": "^9.28.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.30.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.158.0"
  }
}
